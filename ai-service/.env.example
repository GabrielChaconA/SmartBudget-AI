# --- Ollama -------------------------------------------------------------------
# Local (Ollama instalado en Windows/macOS/Linux): http://localhost:11434
# En docker compose se sobrescribe automáticamente con http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# Modelo principal (SBI-1). Cambiar de modelo solo requiere cambiar esta línea.
OLLAMA_MODEL=qwen3:8b

# Modelos de prueba seleccionables por petición con el header X-AI-Model.
# docker compose también los descarga (gemma4:26b ocupa bastante disco).
AI_ALLOWED_MODELS=qwen3:8b,gemma4:e4b,gemma4:26b

# Timeouts (segundos) y reintentos ante errores de conexión / 5xx de Ollama
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_HEALTH_TIMEOUT_SECONDS=3
OLLAMA_MAX_RETRIES=1
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2

# --- Seguridad ----------------------------------------------------------------
# Token compartido con Laravel (mismo valor que AI_SERVICE_TOKEN en backend/.env).
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=change-me-to-a-long-random-token

# --- Comportamiento -----------------------------------------------------------
AI_MAX_HISTORY_MESSAGES=12
# Swagger UI en /docs. Desactívalo fuera de desarrollo.
AI_DOCS_ENABLED=true
LOG_LEVEL=INFO

# Puerto en el host para docker compose (127.0.0.1:<puerto>)
AI_SERVICE_PORT=8001
