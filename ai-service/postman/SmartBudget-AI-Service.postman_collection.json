              ],
              "path": [
                "v1",
                "chat"
              ]
            },
            "description": "Usa la variable `model` (qwen3:8b, gemma4:e4b o gemma4:26b).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {{context}},\n  \"history\": [],\n  \"message\": \"¿Qué suscripciones pago y cuándo se cobran?\",\n  \"language\": \"es\"\n}",
              "options": {
                "raw": {
